# Copy this file to `.env` (same folder) and paste in your own values.
#   cp .env.example .env
#
# `.env` is gitignored — it never gets committed or pushed.

# A FRESH, READ-SCOPED Airtable personal access token.
# Create at https://airtable.com/create/tokens with scope: data.records:read
# Do NOT reuse the write-scoped token that leaked in the ballot page source.
AIRTABLE_TOKEN=

# The Airtable base holding the Performers table.
BASE_ID=

# Optional overrides — defaults shown.
# TABLE=Performers
# BOOKED_FORMULA={In House}
