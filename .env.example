# Copy this file to `.env` (same folder) and paste in your own values.
#   cp .env.example .env
#
# `.env` is gitignored — it never gets committed or pushed.

# Notion internal integration token.
#   1. Create it at https://www.notion.so/my-integrations
#   2. Open the "Models — Roster & Interest" database in Notion
#   3. ••• menu -> Connections -> add the integration
# Read-only capabilities are enough for this build.
NOTION_TOKEN=

# The "Models — Roster & Interest" database.
NOTION_DB_ID=32b9edf5a84b4ca3af236801c9f0ecdb

# The guide page that build-content.mjs renders into content.json.
NOTION_PAGE_ID=3c9bc34c2ab28117980dcba94f79a6a5

# Which Status value means "in the house" (case-insensitive).
# Run `node build-roster.mjs --check` to list the real options.
BOOKED_STATUS=Booked

# Optional. Pin the Notion API version.
# NOTION_VERSION=2022-06-28

# The "Invited (ballot)" database behind the Have a buddy? grid.
NOTION_INVITED_DB_ID=3cabc34c2ab281afa377eb14ef11f92a
